# coppy this file to .env and fill in the values
EMAIL=your_test_email # email for testing signing in
EMAIL_NEW_ACC=your_new_test_email # email for testing creating a new account
PASSWORD=your_password # should be the same for both EMAIL and EMAIL_NEW_ACC
BASE_URL=your_app_base_url # e.g https://localhost:3000 or staging or production url 
FIRST_NAME=your_first_name # first name for testing creating a new account
LAST_NAME=your_last_name   # last name for testing creating a new account
